#!/bin/bash

# coccinella-labs - Master CLI to control all coccinella-labs repositories
# Usage: coccinella-labs <command> [options]

set -e

ORG="coccinella-labs"

# Fetch repos from config repo
get_repos() {
    local raw=$(curl -s "https://raw.githubusercontent.com/$ORG/config/main/repos.json" 2>/dev/null)
    if [ -z "$raw" ]; then
        # Fallback to hardcoded list
        echo ".github activity agent-sdk agentware ai and applekernel appsdk auto-label auto-merge barepi basebin.github.io benchmark bible bin bitinfer bniladridas bniladridas-profile bniladridas.github.io bot bot-identity brew browser browser-archive buildanywhere bump calculator cancel clabot cli cli-tools clicompare clipb coccinella-labs.github.io collab-hub commitfix config core course craft darwin-xnu dependabot-review diff diff-android diff-mac dot dotenv-keep dotfiles echo fix fmtcheck forkcheck gh-pin-repo gh-tag general gitkeep glimpse go-kit gon gpucomm-bot gpucomm-fs gradledemo harper harper-notes harperbot harpertoken harpertoken.github.io hautofix hbadges hbotest hello hi homebrew-kit homebrew-tap hub hwhcore json-repo jupyterml kernelgo kerneljs kernels kernelswift l2 latexgen license lifeboat lilt lock loom macoskernel manager markdownpro mcporg md memoraxx metal mini ml mlapi mlxlm mnistcnn models molplatform nightly omnitype organictyping palmshed palmshed-org patchcore path pathutils press proof prtemplate prune rag react-template release release-assets release-notes resume rl rust-fix rust-nightly scout second simengine skills stale startkit stillness stremiodiag surface swe-agent theme thread title tokensdk tracking tts userstring vertex vesper videos vision warnings weight welcome-bot welcome-issues welcomebot welcomeissues xgboostapi xnubuild"
        return
    fi
    # Use curl to get and parse with jq if available, otherwise simple parse
    if command -v jq &> /dev/null; then
        echo "$raw" | jq -r '.repos[]'
    else
        # Simple JSON parsing without jq
        echo "$raw" | sed 's/.*"repos":\s*\[\([^]]*\)\].*/\1/' | tr ',' '\n' | tr -d ' "'
    fi
}

REPOS=($(get_repos))

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# List all repos
list_repos() {
  echo "Coccinella Labs Repositories:"
  for repo in "${REPOS[@]}"; do
    echo "  - $repo"
  done
}

# Clone all repos
clone_all() {
  local dir="${1:-.}"
  mkdir -p "$dir"
  for repo in "${REPOS[@]}"; do
    if [ "$repo" = ".github" ]; then
      git clone "https://github.com/$ORG/.github.git" "$dir/.github" 2>/dev/null || log_warn "Failed to clone .github"
    else
      git clone "https://github.com/$ORG/$repo.git" "$dir/$repo" 2>/dev/null || log_warn "Failed to clone $repo"
    fi
  done
  log_info "Cloned all repos to $dir"
}

# Pull all repos
pull_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      cd "$repo" && git pull && cd .. || log_warn "Failed to pull $repo"
    fi
  done
  log_info "Pulled all repos"
}

# Push all repos
push_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      cd "$repo" && git push && cd .. || log_warn "Failed to push $repo"
    fi
  done
  log_info "Pushed all repos"
}

# Create new repo
create_repo() {
  local name="$1"
  local description="${2:-New coccinella-labs repository}"
  gh repo create "$ORG/$name" --private --description "$description"
  log_info "Created $ORG/$name"
}

# Execute command in all repos
exec_all() {
  local cmd="$*"
  if [ -z "$cmd" ]; then
    log_error "Please specify a command to run"
    exit 1
  fi
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      echo "=== $repo ==="
      (cd "$repo" && eval "$cmd")
    fi
  done
  log_info "Executed command in all repos"
}

# Show status
status_all() {
  for repo in "${REPOS[@]}"; do
    if [ -d "$repo" ]; then
      echo "=== $repo ==="
      cd "$repo" && git status --short && cd ..
    else
      echo "=== $repo (not cloned) ==="
    fi
  done
}

# Main
case "$1" in
  --help|-h)
    echo "coccinella-labs - Master CLI for Coccinella Labs Organization"
    echo ""
    echo "Usage: coccinella-labs <command>"
    echo ""
    echo "Commands:"
    echo "  list                 List all repositories"
    echo "  clone [dir]          Clone all repos to directory"
    echo "  pull                 Pull all cloned repos"
    echo "  push                 Push all cloned repos"
    echo "  status               Show status of all repos"
    echo "  create <name> [desc] Create new repo"
    echo "  exec <command>       Execute command in all repos"
    echo ""
    echo "Examples:"
    echo "  coccinella-labs list"
    echo "  coccinella-labs clone ~/coccinella-labs"
    echo "  coccinella-labs create my-new-repo"
    ;;
  list)
    list_repos
    ;;
  clone)
    clone_all "${2:-.}"
    ;;
  pull)
    pull_all
    ;;
  push)
    push_all
    ;;
  status)
    status_all
    ;;
  create)
    if [ -z "$2" ]; then
      log_error "Please specify repository name"
      exit 1
    fi
    create_repo "$2" "${3:-}"
    ;;
  exec)
    shift
    exec_all "$@"
    ;;
  *)
    log_error "Unknown command: $1"
    echo "Run 'coccinella-labs --help' for usage"
    exit 1
    ;;
esac